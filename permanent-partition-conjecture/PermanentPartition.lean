import PermanentPartition.FourByFour
import PermanentPartition.FiveByFive

/-!
# Conjecture 4.27 of Boralevi, Carlini, Michałek and Ventura is false

A. Boralevi, E. Carlini, M. Michałek, E. Ventura, *On the codimension of permanental varieties*,
Adv. Math. 461 (2025) 110079, arXiv:2402.17839, conjecture that for the generic `k × k` matrix

  `rad(I(Sing(P))) = ⋂_{(S₁, S₂) ∈ Π} rad(J_{S₁} + J_{S₂})`.

The paper reports a computer check for `k = 3` and leaves `k = 4` open. The equality fails for
`k = 4` and for `k = 5`; in both cases the right-hand side is not contained in the left-hand side.

* `PermanentPartition.Statement` defines both sides from the paper.
* `PermanentPartition.Singular` proves that `Sing(P)` is the common zero set of the permanents of
  order `k - 1`.
* `PermanentPartition.Criterion` reduces the problem to finding one matrix in `Sing(P)` that
  admits no partition of its rows or of its columns into two vanishing parts.
* `PermanentPartition.FourByFour` and `PermanentPartition.FiveByFive` give such matrices.

The `#print axioms` lines below report the axioms each main theorem depends on.
-/

namespace PermanentPartition

theorem partitionIntersection_not_le_four :
    ¬ partitionIntersection 4 ≤ (singularIdeal 4).radical :=
  partitionIntersection_not_le_of_witness H H_isSingular H_no_partition_oriented

theorem partitionIntersection_not_le_five :
    ¬ partitionIntersection 5 ≤ (singularIdeal 5).radical :=
  partitionIntersection_not_le_of_witness A A_isSingular A_no_partition_oriented

/-- Conjecture 4.27 fails for `4 × 4` matrices. -/
theorem conjecture_false_four : ¬ Conjecture 4 :=
  not_conjecture_of_witness H H_isSingular H_no_partition_oriented

/-- Conjecture 4.27 fails for `5 × 5` matrices. -/
theorem conjecture_false_five : ¬ Conjecture 5 :=
  not_conjecture_of_witness A A_isSingular A_no_partition_oriented

/-- The equality also fails when `I(Sing(P))` is read as the ideal generated by the `3 × 3`
permanents of the generic `4 × 4` matrix. -/
theorem criticalIdeal_false_four :
    ¬ partitionIntersection 4 ≤ (criticalIdeal 3).radical :=
  partitionIntersection_not_le_critical_of_witness H H_minors H_no_partition_oriented

/-- The equality also fails when `I(Sing(P))` is read as the ideal generated by the `4 × 4`
permanents of the generic `5 × 5` matrix. -/
theorem criticalIdeal_false_five :
    ¬ partitionIntersection 5 ≤ (criticalIdeal 4).radical :=
  partitionIntersection_not_le_critical_of_witness A A_minors A_no_partition_oriented

end PermanentPartition

#print axioms PermanentPartition.conjecture_false_four
#print axioms PermanentPartition.conjecture_false_five
#print axioms PermanentPartition.partitionIntersection_not_le_four
#print axioms PermanentPartition.partitionIntersection_not_le_five
#print axioms PermanentPartition.criticalIdeal_false_four
#print axioms PermanentPartition.criticalIdeal_false_five
#print axioms PermanentPartition.A_det
