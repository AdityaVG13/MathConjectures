import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.Basic.Complex.Basic
import Mathlib.LinearAlgebra.Matrix.Permanent
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Operations

/-!
# The statement of Conjecture 4.27

Reference: L. Boralevi, E. Carlini, M. Michałek, E. Ventura, *On the codimension of permanental
varieties*, Adv. Math. 461 (2025) 110079, arXiv:2402.17839, Section 4.5.

Let `M = (x_ij)` be the generic `k × k` matrix over the polynomial ring `ℂ[x_ij]` in `k²`
variables, and let `P = {perm M = 0}` be the permanental hypersurface. For a set `R` of rows,
Definition 4.24 lets `J_R` be the ideal generated by all `|R| × |R|` permanents of the submatrix
of `M` on the rows `R`; `J_C` is defined in the same way for a set `C` of columns.
Conjecture 4.27 states the equality of radical ideals

  `rad(I(Sing(P))) = ⋂_{(S₁, S₂) ∈ Π} rad(J_{S₁} + J_{S₂})`,

where `Π` is the set of partitions `(S₁, S₂)` of the `k` rows or of the `k` columns.

This file defines each object directly from that description.

* `J false S` is `J_S` for a set `S` of rows and `J true S` is `J_S` for a set `S` of columns.
  Its generators are the permanents of `M` restricted to the rows `S` (listed in any order) and to
  any `|S|` distinct columns.
* `partitionIntersection k` is the right-hand side. A partition `(S₁, S₂)` is a set `S₁` and its
  complement; the empty part is allowed, which changes nothing because `J_∅` is the unit ideal.
* `singularIdeal k` is `I(Sing(P))`: the polynomials that vanish at every complex matrix where
  `perm M` and all of its first partial derivatives vanish.
* `Conjecture k` is the displayed equality.
-/

namespace PermanentPartition

open MvPolynomial

/-- The polynomial ring `ℂ[x_ij]` in the entries of a `k × k` matrix. -/
abbrev Poly (k : ℕ) := MvPolynomial (Fin k × Fin k) ℂ

/-- The generic matrix `M`, whose `(i, j)` entry is the variable `x_ij`. -/
noncomputable def genericMatrix (k : ℕ) : Matrix (Fin k) (Fin k) (Poly k) :=
  fun i j => X (i, j)

/-- Evaluation of a polynomial at a complex matrix `B`, sending `x_ij` to `B i j`. -/
noncomputable def evaluate {k : ℕ} (B : Matrix (Fin k) (Fin k) ℂ) : Poly k →+* ℂ :=
  eval fun ij => B ij.1 ij.2

/-- `orient false B = B` and `orient true B = Bᵀ`; the second turns columns into rows, so that
statements about rows also cover columns. -/
def orient {k : ℕ} {α : Type*} (column : Bool) (B : Matrix (Fin k) (Fin k) α) :
    Matrix (Fin k) (Fin k) α :=
  if column then B.transpose else B

/-- The maximal permanents of `B` on the rows `S`: the permanents of the square submatrices whose
rows are `S`, listed in any order, and whose columns are any `|S|` distinct columns. -/
def maximalPermanents {k : ℕ} {α : Type*} [CommSemiring α] (B : Matrix (Fin k) (Fin k) α)
    (S : Finset (Fin k)) : Set α :=
  {p | ∃ (m : ℕ) (r c : Fin m → Fin k), Function.Injective r ∧ Function.Injective c ∧
    Finset.univ.image r = S ∧ p = (B.submatrix r c).permanent}

/-- The ideal `J_S` of Definition 4.24: rows when `column = false`, columns when `column = true`. -/
noncomputable def J {k : ℕ} (column : Bool) (S : Finset (Fin k)) : Ideal (Poly k) :=
  Ideal.span (maximalPermanents (orient column (genericMatrix k)) S)

/-- The right-hand side of Conjecture 4.27. The pair `(column, S)` stands for the partition
`(S, Sᶜ)` of the rows (`column = false`) or of the columns (`column = true`). -/
noncomputable def partitionIntersection (k : ℕ) : Ideal (Poly k) :=
  ⨅ p : Bool × Finset (Fin k), (J p.1 p.2 + J p.1 p.2ᶜ).radical

/-- A complex matrix is a point of `Sing(P)` when it lies on `P` and every first partial
derivative of `perm M` vanishes there. -/
def IsSingular {k : ℕ} (B : Matrix (Fin k) (Fin k) ℂ) : Prop :=
  evaluate B (genericMatrix k).permanent = 0 ∧
    ∀ v : Fin k × Fin k, evaluate B (pderiv v (genericMatrix k).permanent) = 0

/-- `I(Sing(P))`, the ideal of all polynomials that vanish on `Sing(P)`. -/
noncomputable def singularIdeal (k : ℕ) : Ideal (Poly k) :=
  ⨅ (B : Matrix (Fin k) (Fin k) ℂ) (_ : IsSingular B), RingHom.ker (evaluate B)

/-- Conjecture 4.27 for `k × k` matrices. -/
def Conjecture (k : ℕ) : Prop :=
  (singularIdeal k).radical = partitionIntersection k

/-- Evaluating a permanent of a submatrix of `M` (or of `Mᵀ`) at `B` gives the permanent of the
same submatrix of `B` (or of `Bᵀ`). -/
theorem evaluate_permanent {k m : ℕ} (B : Matrix (Fin k) (Fin k) ℂ) (column : Bool)
    (r c : Fin m → Fin k) :
    evaluate B ((orient column (genericMatrix k)).submatrix r c).permanent =
      ((orient column B).submatrix r c).permanent := by
  cases column <;>
    simp [Matrix.permanent, Matrix.submatrix, evaluate, genericMatrix, orient, map_sum, map_prod]

theorem evaluate_genericMatrix_permanent {k : ℕ} (B : Matrix (Fin k) (Fin k) ℂ) :
    evaluate B (genericMatrix k).permanent = B.permanent := by
  simp [Matrix.permanent, evaluate, genericMatrix, map_sum, map_prod]

end PermanentPartition
