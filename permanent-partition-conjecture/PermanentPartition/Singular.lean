import PermanentPartition.Expansion
import PermanentPartition.Statement

/-!
# The singular locus of the permanental hypersurface

The partial derivative of `perm M` with respect to `x_ab` is the permanent of `M` with row `a` and
column `b` deleted (`pderiv_permanent`). Consequently a complex matrix lies in `Sing(P)` exactly
when all of its permanents of order `k - 1` vanish (`isSingular_iff`). This is the description
`Sing(P) = {prk(M) ≤ k - 2}` used in Section 4.5 of the paper; here it is proved rather than
assumed.

For the same reason the conjecture is sometimes read with `I(Sing(P))` replaced by the ideal
generated by the `(k - 1) × (k - 1)` permanents. `criticalIdeal` is that ideal, and the main
results cover both readings.
-/

namespace PermanentPartition

open MvPolynomial

/-- The ideal generated by the `k × k` permanents of the generic `(k + 1) × (k + 1)` matrix,
one for each deleted row `r` and deleted column `c`. -/
noncomputable def criticalIdeal (k : ℕ) : Ideal (Poly (k + 1)) :=
  Ideal.span {p | ∃ r c : Fin (k + 1),
    p = ((genericMatrix (k + 1)).submatrix r.succAbove c.succAbove).permanent}

/-- After deleting column `b`, no entry involves a variable `x_ab`, so the permanent of what is
left has zero derivative in `x_ab`. -/
theorem pderiv_permanent_deleted_column {k : ℕ} (a b i : Fin (k + 1)) :
    pderiv (a, b) ((genericMatrix (k + 1)).submatrix i.succAbove b.succAbove).permanent = 0 := by
  rw [Matrix.permanent, map_sum]
  refine Finset.sum_eq_zero fun σ _ => ?_
  refine Finset.prod_induction _ (fun p => pderiv (a, b) p = 0) ?_ ?_ ?_
  · intro p q hp hq
    rw [Derivation.leibniz, hp, hq, smul_zero, smul_zero, add_zero]
  · exact Derivation.map_one_eq_zero _
  · intro l _
    classical
    simp only [Matrix.submatrix_apply, genericMatrix, pderiv_X]
    exact Pi.single_eq_of_ne (fun h => Fin.succAbove_ne b l (congrArg Prod.snd h)) _

/-- `∂ perm M / ∂ x_ab` is the permanent of `M` with row `a` and column `b` deleted. -/
theorem pderiv_permanent {k : ℕ} (a b : Fin (k + 1)) :
    pderiv (a, b) (genericMatrix (k + 1)).permanent =
      ((genericMatrix (k + 1)).submatrix a.succAbove b.succAbove).permanent := by
  classical
  rw [permanent_expand_column _ b, map_sum]
  simp only [Derivation.leibniz, pderiv_permanent_deleted_column, genericMatrix, pderiv_X,
    smul_eq_mul]
  rw [Finset.sum_eq_single a]
  · simp
  · intro i _ hi
    simp [Prod.ext_iff, hi]
  · simp

/-- A complex matrix lies in `Sing(P)` exactly when all of its permanents of order `k` vanish. -/
theorem isSingular_iff {k : ℕ} (B : Matrix (Fin (k + 1)) (Fin (k + 1)) ℂ) :
    IsSingular B ↔ ∀ r c : Fin (k + 1), (B.submatrix r.succAbove c.succAbove).permanent = 0 := by
  have hminor : ∀ r c : Fin (k + 1),
      evaluate B ((genericMatrix (k + 1)).submatrix r.succAbove c.succAbove).permanent =
        (B.submatrix r.succAbove c.succAbove).permanent :=
    fun r c => evaluate_permanent B false r.succAbove c.succAbove
  constructor
  · intro h r c
    rw [← hminor, ← pderiv_permanent]
    exact h.2 (r, c)
  · intro h
    refine ⟨?_, ?_⟩
    · rw [evaluate_genericMatrix_permanent]
      exact permanent_eq_zero_of_cofactors B h
    · rintro ⟨a, b⟩
      rw [pderiv_permanent, hminor]
      exact h a b

end PermanentPartition
