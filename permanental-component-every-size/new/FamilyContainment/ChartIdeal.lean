import FamilyContainment.AmbientIdeal

set_option backward.isDefEq.respectTransparency false
namespace ComponentFamilyContainment
open Matrix Equiv
variable {R : Type*} [CommRing R]

/-- Explicit ambient chart generators: 3m lower-left entries; four upper
permanents; one lower permanent; and 2(m-1) proportionality relations.
Thus there are 5m+3 listed generators for m=k+1 (possibly redundant). -/
def chartGenerators {k : ℕ} (U : Matrix (Fin 3) (Fin 3) R)
    (V : Matrix (Fin 3) (Fin (k+1)) R) (L : Matrix (Fin (k+1)) (Fin 3) R)
    (W : Matrix (Fin (k+1)) (Fin (k+1)) R) : Set R :=
  Set.range (fun ac : Fin (k+1) × Fin 3 => L ac.1 ac.2) ∪
  {W.permanent, U.permanent} ∪
  Set.range (fun j : Fin 3 => (augmented (U.submatrix id j.succAbove) (fun i => V i 0)).permanent) ∪
  Set.range (fun ij : Fin 2 × Fin k =>
    V 0 0 * V ij.1.succ ij.2.succ - V ij.1.succ 0 * V 0 ij.2.succ)

def chartIdeal {k : ℕ} (U : Matrix (Fin 3) (Fin 3) R)
    (V : Matrix (Fin 3) (Fin (k+1)) R) (L : Matrix (Fin (k+1)) (Fin 3) R)
    (W : Matrix (Fin (k+1)) (Fin (k+1)) R) : Ideal R :=
  Ideal.span (chartGenerators U V L W)

/-- The ideal generated by actual submaximal permanents of the ambient matrix
is contained in the explicit chart ideal, provided its pivot is a unit modulo
that chart ideal. In particular this applies after localizing at the pivot. -/
theorem ambient_submaximal_ideal_le_chart {k : ℕ}
    (U : Matrix (Fin 3) (Fin 3) R) (V : Matrix (Fin 3) (Fin (k+1)) R)
    (L : Matrix (Fin (k+1)) (Fin 3) R) (W : Matrix (Fin (k+1)) (Fin (k+1)) R)
    (hunit : IsUnit (Ideal.Quotient.mk (chartIdeal U V L W) (V 0 0))) :
    Ideal.span (Set.range (fun rc : Fin (3+k+1) × Fin (3+k+1) =>
      ((ambientFin U V L W).submatrix rc.1.succAbove rc.2.succAbove).permanent)) ≤
      chartIdeal U V L W := by
  apply Ideal.span_le.mpr
  rintro _ ⟨⟨r,c⟩, rfl⟩
  apply ambient_cofactors_mem_ideal _ U V L W hunit
  · intro a j
    apply Ideal.subset_span
    simp only [chartGenerators, Set.mem_union, Set.mem_range]
    exact Or.inl (Or.inl (Or.inl ⟨(a,j), rfl⟩))
  · apply Ideal.subset_span
    simp [chartGenerators]
  · apply Ideal.subset_span
    simp [chartGenerators]
  · intro j
    apply Ideal.subset_span
    simp only [chartGenerators, Set.mem_union, Set.mem_range]
    exact Or.inl (Or.inr ⟨j, rfl⟩)
  · intro i j
    refine Fin.cases ?_ (fun a => ?_) i
    · have hz : V 0 0 * V 0 j - V 0 0 * V 0 j = 0 := sub_self _
      rw [hz]
      exact Ideal.zero_mem _
    · refine Fin.cases ?_ (fun b => ?_) j
      · have hz : V 0 0 * V a.succ 0 - V a.succ 0 * V 0 0 = 0 := by ring
        rw [hz]
        exact Ideal.zero_mem _
      · apply Ideal.subset_span
        simp only [chartGenerators, Set.mem_union, Set.mem_range]
        exact Or.inr ⟨(a,b), rfl⟩

/-- Convenient localized-ring form: a unit pivot in the ring itself suffices. -/
theorem ambient_submaximal_ideal_le_chart_of_unit {k : ℕ}
    (U : Matrix (Fin 3) (Fin 3) R) (V : Matrix (Fin 3) (Fin (k+1)) R)
    (L : Matrix (Fin (k+1)) (Fin 3) R) (W : Matrix (Fin (k+1)) (Fin (k+1)) R)
    (hunit : IsUnit (V 0 0)) :
    Ideal.span (Set.range (fun rc : Fin (3+k+1) × Fin (3+k+1) =>
      ((ambientFin U V L W).submatrix rc.1.succAbove rc.2.succAbove).permanent)) ≤
      chartIdeal U V L W := by
  apply ambient_submaximal_ideal_le_chart
  exact hunit.map (Ideal.Quotient.mk (chartIdeal U V L W))

#print axioms ambient_submaximal_ideal_le_chart
end ComponentFamilyContainment
