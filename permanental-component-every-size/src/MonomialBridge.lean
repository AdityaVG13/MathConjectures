import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Data.Matrix.Mul
import Mathlib.Tactic

/-!
# Conditional semantic bridge for monomial local-ideal certificates

This file proves generic implications. It does not assert that the actual
permanent polynomials satisfy the support or coefficient hypotheses.

For monomial generators `g`, exact support divisibility establishes membership
in their ideal `J`. A polynomial in `J` whose coefficients at every generator
exponent vanish is in `m * J`, where `m` is the ideal of all variables. Thus
subtracting the coefficient projection loses only an element of `m * J`.
-/

namespace LocalGeometryMonomial

open MvPolynomial

variable {σ ι κ R : Type*} [CommRing R]

/-- The ideal of the monic monomials with exponent vectors `g`. -/
noncomputable def monomialIdeal (g : ι → σ →₀ ℕ) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun i => monomial (g i) (1 : R))

/-- Exact support test, not a finite-degree truncation test. -/
theorem mem_monomialIdeal_iff (g : ι → σ →₀ ℕ) (f : MvPolynomial σ R) :
    f ∈ monomialIdeal g ↔ ∀ d ∈ f.support, ∃ i, g i ≤ d := by
  unfold monomialIdeal
  have hset : Set.range (fun i => monomial (g i) (1 : R)) =
      (fun d => monomial d (1 : R)) '' Set.range g := by
    ext p
    simp
  rw [hset, mem_ideal_span_monomial_image]
  simp

/-- A polynomial ideal generated by equations satisfying the exact support
criterion is contained in the monomial ideal. -/
theorem span_le_monomialIdeal_of_support
    (g : ι → σ →₀ ℕ) (f : κ → MvPolynomial σ R)
    (hsupport : ∀ k d, d ∈ (f k).support → ∃ i, g i ≤ d) :
    Ideal.span (Set.range f) ≤ monomialIdeal g := by
  rw [Ideal.span_le]
  rintro _ ⟨k, rfl⟩
  exact (mem_monomialIdeal_iff g (f k)).mpr (hsupport k)

/-- Every nonconstant monomial belongs to the ideal of all variables. -/
theorem monomial_mem_idealOfVars {d : σ →₀ ℕ} (hd : d ≠ 0) (c : R) :
    monomial d c ∈ idealOfVars σ R := by
  classical
  by_cases hc : c = 0
  · simp [hc]
  rw [← pow_one (idealOfVars σ R), monomial_mem_pow_idealOfVars_iff 1 d hc]
  exact Nat.one_le_iff_ne_zero.mpr (mt (Finsupp.degree_eq_zero_iff d).mp hd)

/-- The semantic reason the coefficient projection has remainder in `mJ`:
any supported exponent strictly above a generator has a nonconstant factor. -/
theorem mem_vars_mul_of_mem_and_coeff_zero
    (g : ι → σ →₀ ℕ) {f : MvPolynomial σ R}
    (hf : f ∈ monomialIdeal g)
    (hcoeff : ∀ i, f.coeff (g i) = 0) :
    f ∈ idealOfVars σ R * monomialIdeal g := by
  classical
  rw [f.as_sum]
  apply Ideal.sum_mem
  intro d hd
  obtain ⟨i, hi⟩ := (mem_monomialIdeal_iff g f).mp hf d hd
  obtain ⟨e, he⟩ := le_iff_exists_add'.mp hi
  have he0 : e ≠ 0 := by
    intro hz
    have hdg : d = g i := by simpa [hz] using he
    exact (mem_support_iff.mp hd) (hdg.symm ▸ hcoeff i)
  have hleft : monomial e (f.coeff d) ∈ idealOfVars σ R :=
    monomial_mem_idealOfVars he0 _
  have hright : monomial (g i) (1 : R) ∈ monomialIdeal g :=
    Ideal.subset_span (Set.mem_range_self i)
  have hmul := Ideal.mul_mem_mul hleft hright
  simpa [monomial_mul_monomial, ← he] using hmul

/-- Keep only the coefficients at the given monomial generators. -/
noncomputable def coefficientProjection [Fintype ι]
    (g : ι → σ →₀ ℕ) (f : MvPolynomial σ R) : MvPolynomial σ R :=
  ∑ i, monomial (g i) (f.coeff (g i))

/-- Each retained term remains in the target ideal. -/
theorem coefficientProjection_mem [Fintype ι]
    (g : ι → σ →₀ ℕ) (f : MvPolynomial σ R) :
    coefficientProjection g f ∈ monomialIdeal g := by
  classical
  apply Ideal.sum_mem
  intro i _
  have h : monomial (g i) (1 : R) ∈ monomialIdeal g :=
    Ideal.subset_span (Set.mem_range_self i)
  simpa [C_mul_monomial] using (monomialIdeal g).mul_mem_left (C (f.coeff (g i))) h

/-- Distinct generator exponents are required to avoid counting a coefficient
more than once in the projection. -/
theorem coeff_coefficientProjection [Fintype ι]
    (g : ι → σ →₀ ℕ) (hg : Function.Injective g)
    (f : MvPolynomial σ R) (i : ι) :
    (coefficientProjection g f).coeff (g i) = f.coeff (g i) := by
  classical
  simp [coefficientProjection, coeff_monomial, hg.eq_iff]

/-- Subtracting all generator-coefficient terms leaves an element of `mJ`.
There is no unsupported assertion identifying a jet quotient with `J/mJ`. -/
theorem sub_coefficientProjection_mem_vars_mul [Fintype ι]
    (g : ι → σ →₀ ℕ) (hg : Function.Injective g)
    {f : MvPolynomial σ R} (hf : f ∈ monomialIdeal g) :
    f - coefficientProjection g f ∈ idealOfVars σ R * monomialIdeal g := by
  apply mem_vars_mul_of_mem_and_coeff_zero g
  · exact (monomialIdeal g).sub_mem hf (coefficientProjection_mem g f)
  · intro i
    simp [coeff_coefficientProjection g hg]


/-- Algebraic reconstruction by a left inverse, valid over a commutative ring. -/
theorem reconstruct_of_matrix_leftInverse [Fintype ι] [DecidableEq ι] [Fintype κ]
    (A : Matrix ι κ R) (B : Matrix κ ι R) (hAB : A * B = 1)
    (v : ι → MvPolynomial σ R) (i : ι) :
    (∑ k, C (A i k) * (∑ j, C (B k j) * v j)) = v i := by
  simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_mul, ← map_sum]
  change (∑ j, C ((A * B) i j) * v j) = v i
  rw [hAB]
  simp [Matrix.one_apply]

/-- The precise coefficient matrix attached to actual input polynomials. -/
noncomputable def coefficientMatrix
    (g : ι → σ →₀ ℕ) (f : κ → MvPolynomial σ R) : Matrix κ ι R :=
  fun k i => (f k).coeff (g i)

/-- The principal conditional certificate bridge. Exact support divisibility
proves `I ≤ J`; an actual left inverse of the actual generator-coefficient
matrix proves `J = I + mJ`. Neither conclusion is assumed. -/
theorem monomialIdeal_eq_span_sup_vars_mul_of_leftInverse
    [Fintype ι] [DecidableEq ι] [Fintype κ]
    (g : ι → σ →₀ ℕ) (hg : Function.Injective g)
    (f : κ → MvPolynomial σ R)
    (hsupport : ∀ k d, d ∈ (f k).support → ∃ i, g i ≤ d)
    (A : Matrix ι κ R) (hA : A * coefficientMatrix g f = 1) :
    monomialIdeal g = Ideal.span (Set.range f) ⊔ idealOfVars σ R * monomialIdeal g := by
  classical
  have hIJ := span_le_monomialIdeal_of_support g f hsupport
  apply le_antisymm ?_ (sup_le hIJ Ideal.mul_le_right)
  rw [monomialIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  have hprojection (k : κ) : coefficientProjection g (f k) ∈
      Ideal.span (Set.range f) ⊔ idealOfVars σ R * monomialIdeal g := by
    have hf : f k ∈ Ideal.span (Set.range f) := Ideal.subset_span (Set.mem_range_self k)
    have hd := sub_coefficientProjection_mem_vars_mul g hg (hIJ hf)
    have hp := (Ideal.span (Set.range f) ⊔ idealOfVars σ R * monomialIdeal g).sub_mem
      (Ideal.mem_sup_left hf) (Ideal.mem_sup_right hd)
    simpa only [sub_sub_cancel] using hp
  have hcomb : (∑ k, C (A i k) * coefficientProjection g (f k)) ∈
      Ideal.span (Set.range f) ⊔ idealOfVars σ R * monomialIdeal g := by
    apply Ideal.sum_mem
    intro k _
    exact Ideal.mul_mem_left _ _ (hprojection k)
  have hreconstruct := reconstruct_of_matrix_leftInverse A (coefficientMatrix g f) hA
    (fun j => monomial (g j) (1 : R)) i
  simp only [C_mul_monomial, mul_one, coefficientMatrix] at hreconstruct
  change monomial (g i) (1 : R) ∈ Ideal.span (Set.range f) ⊔ idealOfVars σ R * monomialIdeal g
  rw [← hreconstruct]
  exact hcomb

/-- A square inverse certificate on selected equations suffices. Unselected
rows need only satisfy the exact target-ideal support test. -/
theorem monomialIdeal_eq_span_sup_vars_mul_of_selected_leftInverse
    {ν : Type*} [Fintype ι] [DecidableEq ι] [Fintype ν]
    (g : ι → σ →₀ ℕ) (hg : Function.Injective g)
    (f : κ → MvPolynomial σ R)
    (hsupport : ∀ k d, d ∈ (f k).support → ∃ i, g i ≤ d)
    (selected : ν → κ) (A : Matrix ι ν R)
    (hA : A * coefficientMatrix g (f ∘ selected) = 1) :
    monomialIdeal g = Ideal.span (Set.range f) ⊔ idealOfVars σ R * monomialIdeal g := by
  have hselected := monomialIdeal_eq_span_sup_vars_mul_of_leftInverse g hg
    (f ∘ selected) (fun k => hsupport (selected k)) A hA
  have hsmall : Ideal.span (Set.range (f ∘ selected)) ≤ Ideal.span (Set.range f) := by
    apply Ideal.span_mono
    rintro _ ⟨i, rfl⟩
    exact Set.mem_range_self (selected i)
  exact le_antisymm (hselected.le.trans (sup_le_sup_right hsmall _))
    (sup_le (span_le_monomialIdeal_of_support g f hsupport) Ideal.mul_le_right)
end LocalGeometryMonomial

#print axioms LocalGeometryMonomial.mem_vars_mul_of_mem_and_coeff_zero
#print axioms LocalGeometryMonomial.sub_coefficientProjection_mem_vars_mul
#print axioms LocalGeometryMonomial.monomialIdeal_eq_span_sup_vars_mul_of_leftInverse
#print axioms LocalGeometryMonomial.monomialIdeal_eq_span_sup_vars_mul_of_selected_leftInverse
